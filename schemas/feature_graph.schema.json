{
  "type": "object",
  "required": ["feature_id", "goal", "folder_structure", "nodes", "edges", "code_targets", "user_flow", "sequence_diagram", "plantuml_flow", "plantuml_sequence"],
  "properties": {
    "feature_id": { "type": "string" },
    "goal": { "type": "string" },
    "contract": { "type": "object" },
    "implementation_order": { "type": "array", "items": { "type": "string" } },
    "folder_structure": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["folder", "code_targets"],
        "properties": {
          "folder": { "type": "string" },
          "code_targets": { "type": "array", "items": { "type": "string" } },
          "rule": { "type": "string" }
        }
      }
    },
    "project_structure": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "folder": { "type": "string" },
          "file_count": { "type": "number" },
          "roles": { "type": "array", "items": { "type": "string" } },
          "examples": { "type": "array", "items": { "type": "string" } },
          "selected_files": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "type"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "type": { "type": "string" },
          "code_targets": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "condition": { "type": "string" }
        }
      }
    },
    "error_nodes": { "type": "array", "items": { "type": "string" } },
    "code_targets": { "type": "array", "items": { "type": "string" } },
    "target_rationale": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "reason"],
        "properties": {
          "path": { "type": "string" },
          "role": { "type": "string" },
          "score": { "type": ["number", "null"] },
          "matched_terms": { "type": "array", "items": { "type": "string" } },
          "reason": { "type": "string" }
        }
      }
    },
    "user_flow": { "type": "string" },
    "sequence_diagram": { "type": "string" },
    "api_graph": { "type": "string" },
    "api_links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "api": { "type": "string" },
          "route": { "type": "string" },
          "related_code": { "type": "array", "items": { "type": "string" } },
          "imports": { "type": "array", "items": { "type": "string" } },
          "reason": { "type": "string" }
        }
      }
    },
    "plantuml_flow": { "type": "string" },
    "plantuml_sequence": { "type": "string" },
    "plantuml_api_graph": { "type": "string" },
    "acceptance_checks": { "type": "array", "items": { "type": "string" } },
    "mermaid": { "type": "string" }
  }
}
